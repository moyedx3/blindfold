VITE_INDEXER_URL=http://127.0.0.1:8080
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300
# Required for a real TEE; copy the verified 96-hex RTMR3 from deploy/networks.json.
VITE_EXPECTED_MEASUREMENT_HEX=
# DCAP collateral service. The browser needs one that allows CORS; Intel's PCS does not, Phala's
# does and is the library default. Set explicitly to pin it.
VITE_PCCS_URL=https://pccs.phala.network
# Development only. Production builds ignore fake-wallet mode.
VITE_FAKE_WALLET=
