{
  "name": "blindfold",
  "private": true,
  "type": "module",
  "workspaces": [
    "contract",
    "indexer",
    "packages/*",
    "buyer",
    "creator"
  ],
  "scripts": {
    "compile": "npm run compile -w contract",
    "test": "npm test --workspaces --if-present",
    "check:runtime-copies": "test \"$(find node_modules -type d -path '*@midnight-ntwrk/onchain-runtime-v3' | wc -l | tr -d ' ')\" = 1 && echo 'ok: one onchain-runtime copy'",
    "devnet:up": "docker compose -f deploy/devnet/docker-compose.yml up -d --wait",
    "devnet:down": "docker compose -f deploy/devnet/docker-compose.yml down",
    "devnet:reset": "docker compose -f deploy/devnet/docker-compose.yml down -v",
    "demo:local": "bash deploy/scripts/demo-local.sh",
    "demo:recover": "npx tsx deploy/scripts/reprovision-demo.ts",
    "demo:stop": "bash deploy/scripts/stop-indexer.sh",
    "qa:secrets": "node deploy/scripts/check-secret-sinks.mjs",
    "qa:demo": "bash deploy/scripts/qa-demo.sh",
    "smoke:live": "npx tsx deploy/scripts/smoke-live.ts",
    "attest:inspect": "npx tsx deploy/scripts/inspect-attestation.ts",
    "site:build": "node deploy/scripts/build-site.mjs",
    "site:deploy": "bash deploy/scripts/deploy-site.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@phala/dcap-qvl": "^0.5.2",
    "libsodium-wrappers": "0.7.15",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
